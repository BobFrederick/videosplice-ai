# VideoSplice AI - Environment Variables
# Copy this file to .env and fill in your values

# ==================================
# LLM Configuration
# ==================================

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Local LLM (Ollama) Configuration
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama2

# LM Studio Configuration
LM_STUDIO_ENDPOINT=http://localhost:1234/v1

# ==================================
# Database Configuration
# ==================================

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/videosplice
DATABASE_POOL_SIZE=10

# ==================================
# Redis Configuration (Job Queue)
# ==================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================================
# Storage Configuration
# ==================================

# S3-Compatible Storage (AWS S3, MinIO, etc.)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=videosplice-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# Local File Storage (Alternative to S3)
LOCAL_STORAGE_PATH=/var/videosplice/storage
MAX_STORAGE_SIZE_GB=100

# ==================================
# Application Configuration
# ==================================

# Server
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# CORS Settings
CORS_ORIGIN=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# File Upload
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv,webm
TEMP_UPLOAD_DIR=/tmp/videosplice/uploads

# ==================================
# Processing Configuration
# ==================================

# Video Processing
FFMPEG_PATH=/usr/bin/ffmpeg
MAX_VIDEO_DURATION_MINUTES=180
VIDEO_PROCESSING_TIMEOUT_MINUTES=60

# Transcription
WHISPER_MODEL=base
WHISPER_LANGUAGE=auto
TRANSCRIPTION_TIMEOUT_MINUTES=30

# Segmentation
MIN_SEGMENT_DURATION_SECONDS=5
MAX_SEGMENTS_PER_VIDEO=50
DEFAULT_LLM_PROVIDER=openai

# ==================================
# Job Queue Configuration
# ==================================

# BullMQ Settings
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_MINUTES=60
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY_MS=5000

# ==================================
# User & Authentication
# ==================================

# JWT Configuration
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d

# Session
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE_MS=86400000

# Password Requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_PASSWORD_COMPLEXITY=true

# ==================================
# Quota Management
# ==================================

# Default User Quotas
DEFAULT_STORAGE_QUOTA_GB=10
DEFAULT_PROCESSING_MINUTES_QUOTA=60
DEFAULT_MONTHLY_UPLOAD_QUOTA=100

# ==================================
# Monitoring & Logging
# ==================================

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/videosplice/app.log

# Metrics (Optional)
ENABLE_METRICS=false
PROMETHEUS_PORT=9090

# Sentry (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ==================================
# Email Configuration (Optional)
# ==================================

# SMTP Settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@videosplice.ai

# ==================================
# Feature Flags
# ==================================

# Enable/Disable Features
ENABLE_USER_REGISTRATION=true
ENABLE_SOCIAL_AUTH=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_WEBHOOK_CALLBACKS=false
ENABLE_BATCH_PROCESSING=false

# ==================================
# Development & Debug
# ==================================

# Development Tools
ENABLE_DEBUG_MODE=false
ENABLE_QUERY_LOGGING=false
ENABLE_PROFILING=false

# Testing
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/videosplice_test

# ==================================
# Notes
# ==================================

# 1. Never commit .env file to version control
# 2. Use strong, unique secrets for production
# 3. Rotate API keys and secrets regularly
# 4. Use environment-specific values (dev/staging/prod)
# 5. Validate all environment variables on startup
