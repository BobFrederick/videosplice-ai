{
  "name": "videosplice-queue-server",
  "version": "1.0.0",
  "description": "BullMQ job queue server for video processing",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/server/src/app.js",
    "worker": "node dist/server/src/workers/videoProcessor.js"
  },
  "dependencies": {
    "@types/form-data": "^2.5.2",
    "axios": "^1.13.0",
    "bullmq": "^5.61.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "form-data": "^4.0.4",
    "ioredis": "^5.8.2",
    "module-alias": "^2.2.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "ts-node": "^10.9.2",
    "uuid": "^9.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.24",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "_moduleAliases": {
