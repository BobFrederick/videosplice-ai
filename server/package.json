{
  "name": "videosplice-queue-server",
  "version": "1.0.0",
  "description": "BullMQ job queue server for video processing",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "worker": "node -r ts-node/register src/workers/videoProcessor.ts"
  },
  "dependencies": {
    "@types/form-data": "^2.2.1",
    "bullmq": "^5.61.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "form-data": "^4.0.4",
    "ioredis": "^5.8.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "ts-node": "^10.9.2",
    "uuid": "^9.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.24",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.23",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
